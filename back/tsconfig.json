{
  "compilerOptions": {
    "target": "ES2020",                                  /* Define a versão do JavaScript para os arquivos gerados. */
    "module": "commonjs",                                /* Especifica o tipo de módulo gerado. */
    "esModuleInterop": true,                             /* Facilita o suporte à importação de módulos CommonJS. */
    "forceConsistentCasingInFileNames": true,            /* Garante que o casing das importações esteja correto. */
    "strict": true,                                      /* Habilita todas as opções de verificação de tipos rigorosas. */
    "skipLibCheck": true,                                /* Ignora a verificação de tipos de arquivos .d.ts. */
    "outDir": "./dist",                                  /* Diretório onde os arquivos compilados serão colocados. */
    "rootDir": "./src",
  },
  "include": ["src/**/*.ts"],      /* Inclui todos os arquivos TypeScript dentro da pasta src. */
  "exclude": ["node_modules"]      /* Exclui a pasta node_modules da compilação. */
}
